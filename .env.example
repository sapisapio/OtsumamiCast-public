# OtsumamiCast - 環境変数設定例
# このファイルを .env にコピーして、必要に応じて値を変更してください

# ===== サーバー設定 =====
# バインドするポート番号（デフォルト: 7244）
PORT=7244

# バインドするホスト（デフォルト: localhost）
HOST=localhost

# 環境（development | production）
NODE_ENV=development

# デバッグモード（true | false）
DEBUG=false

# ===== UPnP設定 =====
# UPnP有効化（true | false）
UPNP_ENABLED=true
