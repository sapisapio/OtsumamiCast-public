{
  "name": "otsumamicast",
  "version": "0.2.6",
  "description": "YouTube同期視聴デスクトップアプリ - PeerCast配信者向けツール",
  "main": "electron-main.js",
  "author": "sapisapio",
  "license": "ISC",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "electron .",
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "node --test tests/*.test.cjs"
  },
  "keywords": [
    "youtube",
    "sync",
    "peercast",
    "streaming",
    "desktop"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "nat-upnp": "^1.1.1",
    "sharp": "^0.34.5",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^39.1.1",
    "electron-builder": "^23.6.0"
  },
  "build": {
    "appId": "com.otsumamicast.app",
    "productName": "おつまみキャスト",
    "asar": false,
    "files": [
      "electron-main.js",
      "preload.js",
      "preload-overlay.js",
      "server/**/*",
      "public/**/*",
      "config/**/*",
      "ipc/**/*",
      "windows/**/*",
      "!server/data/**",
      "!public/*-config.json",
      "!public/stamps/**",
      "!public/images/profile-photo*",
      "!public/images/vcast-avatar*",
      "!public/images/ohinerimaki-qr*"
    ],
    "extraResources": [
      {
        "from": "ffmpeg-bin/",
        "to": "app/ffmpeg-bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "おつまみキャスト"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}

