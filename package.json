{
  "name": "otsumamicast",
  "version": "0.2.5",
  "description": "YouTube同期視聴デスクトップアプリ - PeerCast配信者向けツール",
  "main": "electron-main.js",
  "author": "sapisapio",
  "license": "ISC",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "electron .",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "youtube",
    "sync",
    "peercast",
    "streaming",
    "desktop"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "nat-upnp": "^1.1.1",
    "sharp": "^0.34.5",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^39.1.1",
    "electron-builder": "^23.6.0"
  },
  "build": {
    "appId": "com.otsumamicast.app",
    "productName": "おつまみキャスト",
    "asar": false,
    "files": [
      "electron-main.js",
      "preload.js",
      "preload-overlay.js",
      "server/**/*",
      "public/**/*",
      "config/**/*",
      "ipc/**/*",
      "windows/**/*",
      "node_modules/**/*"
    ],
      "extraResources": [
    {
      "from": "ffmpeg-bin/",
      "to": "app/ffmpeg-bin",
      "filter": ["**/*"]
    }
  ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
      "nsis": {
    "oneClick": false,                         
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "おつまみキャスト"
  },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
